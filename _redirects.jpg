# --- Permanent redirects for Google 404s ---
/embed                          /                       301
/embed/                         /                       301
/subscribe                      /contact/               301
/subscribe/                     /contact/               301
/assets/data/releases           /releases/              301
/assets/data/releases/          /releases/              301
/release/kaanch-ki-tarah-2      /release/kaanch-ki-tarah/  301
/release/kaanch-ki-tarah-2/     /release/kaanch-ki-tarah/  301

# --- SPA rewrites (must stay 200 so release/artist pages load) ---
/artist/*                       /artist/index.html      200
/release/*                      /release/index.html     200
